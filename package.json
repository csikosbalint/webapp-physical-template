{
  "name": "webapp-physical-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "directories": {
    "test": "test"
  },
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./src/api.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "create:env": "node --env-file=.env --env-file=.env.local scripts/create-env.ts",
    "create:app": "node --env-file=.env --env-file=.env.local scripts/create-app.ts",
    "delete": "node --env-file=.env --env-file=.env.local scripts/delete.js",
    "test": "node --env-file=.env --test \"test/**/*.test.ts\"",
    "test:local": "node --env-file=.env --env-file=.env.local --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@octokit/rest": "22.0.1",
    "@vercel/client": "18.6.2",
    "@vercel/sdk": "1.28.38"
  },
  "devDependencies": {
    "@types/node": "22.18.1",
    "typescript": "5.9.3"
  }
}